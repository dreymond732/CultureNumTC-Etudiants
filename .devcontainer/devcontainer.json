{
  "name": "BUT TC Toulon — Atelier Web",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    8000,
    8001,
    8765
  ],
  "portsAttributes": {
    "8000": {
      "label": "BUT TC Toulon — serveur A TD4 et TD1/TD2",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "BUT TC Toulon — serveur B TD4",
      "onAutoForward": "notify"
    },
    "8765": {
      "label": "BUT-Boutique — Adminer TD6 (Private uniquement)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "MS-CEINTL.vscode-language-pack-fr",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.autoSave": "off",
        "editor.formatOnSave": false,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "github.copilot.chat.localeOverride": "fr"
      }
    }
  },
  "postCreateCommand": "python3 --version"
}
