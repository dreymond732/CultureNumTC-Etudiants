{
  "name": "BUT TC Toulon — Atelier Web",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "BUT TC Toulon — serveur Web TD2",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "MS-CEINTL.vscode-language-pack-fr",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.autoSave": "off",
        "editor.formatOnSave": false,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "github.copilot.chat.localeOverride": "fr"
      }
    }
  },
  "postCreateCommand": "python3 --version"
}
